# Circular-to-Action Converter Configuration
PROJECT_NAME="Circular-to-Action Converter"
VERSION="1.0.0"
DEBUG=true

# Database (Default: SQLite, for PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/campus_db)
DATABASE_URL="sqlite+aiosqlite:///./campus_utility.db"

# Security (Replace with strong secret key in production)
SECRET_KEY="campus-utility-production-secure-jwt-secret-key-2026-campus-notice"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=50

# AI Provider ("mock", "openai", "gemini")
# "mock" uses the deterministic extraction engine (no API key required, zero latency)
AI_PROVIDER="mock"
AI_MODEL="gpt-4o"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_TIMEOUT_SECONDS=30
